<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Kiwdy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_3</item>

        <item name="colorPrimaryContainer">@color/purple_700</item>

        <item name="colorSecondary">@color/teal_200</item>


        <item name="android:statusBarColor">@color/green_3</item>
    </style>

    <style name="Theme.Kiwdy.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Kiwdy.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Kiwdy.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>