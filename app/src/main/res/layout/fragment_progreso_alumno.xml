<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.instructor.inscripciones.ProgresoAlumnoFragment" >

    <TextView
        android:id="@+id/tvFechaFinalizadoLabelProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:text="Fecha finalizaión:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaInscriptoLabelProgreso" />

    <TextView
        android:id="@+id/tvNombreApellidoAlumnoProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TextView"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.059"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAceptarInscripcionProgreso"
        android:layout_width="124dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:text="Aceptar inscripción"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.89"
        app:layout_constraintStart_toEndOf="@+id/tvNombreApellidoAlumnoProgreso"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFechaInscriptoProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="TextView"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.028"
        app:layout_constraintStart_toEndOf="@+id/tvFechaInscriptoLabelProgreso"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreApellidoAlumnoProgreso"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/tvFechaInscriptoLabelProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="28dp"
        android:text="Fecha de inicio:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreApellidoAlumnoProgreso" />

    <TextView
        android:id="@+id/tvProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Progreso"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.011"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaFinalizadoLabelProgreso"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/tvFechaFinalizadoProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="TextView"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.029"
        app:layout_constraintStart_toEndOf="@+id/tvFechaFinalizadoLabelProgreso"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaInscriptoProgreso"
        tools:visibility="invisible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btAgendarExamenProgreso"
        android:layout_width="120dp"
        android:layout_height="33dp"
        android:layout_marginEnd="288dp"
        android:text="Agendar exámen"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btDescargarCertificadoProgreso"
        app:layout_constraintVertical_bias="0.026"
        tools:visibility="invisible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btDescargarCertificadoProgreso"
        android:layout_width="141dp"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:text="Descargar certificado"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pdfViewCertificadoProgreso"
        tools:visibility="invisible" />

    <ProgressBar
        android:id="@+id/progressBarProgreso"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="303dp"
        android:layout_height="17dp"
        android:layout_marginTop="32dp"
        android:max="100"
        android:progress="0"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.814"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFechaFinalizadoProgreso" />

    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/pdfViewCertificadoProgreso"
        android:layout_width="350dp"
        android:layout_height="190dp"
        android:layout_marginTop="28dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBarProgreso" />

    <TextView
        android:id="@+id/tvProximoExamenLabelProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btAgendarExamenProgreso" />

    <TextView
        android:id="@+id/tvExamenesInfoProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aún no hay exámenes agendados"
        android:textSize="24sp"
        android:textStyle="italic"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProximoExamenLabelProgreso" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSeccionExamenesProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProximoExamenLabelProgreso">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExamenesProgreso"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNotaAprobaciónProgreso"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/tvEstadoUltimoExamenLabelProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Último exámen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEstadoUltimoExamenProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/tvEstadoUltimoExamenLabelProgreso"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNotaAprobaciónLabelProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota mínima:"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEstadoUltimoExamenLabelProgreso" />

        <TextView
            android:id="@+id/tvNotaAprobaciónProgreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.041"
            app:layout_constraintStart_toEndOf="@+id/tvNotaAprobaciónLabelProgreso"
            app:layout_constraintTop_toBottomOf="@+id/tvEstadoUltimoExamenProgreso" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>